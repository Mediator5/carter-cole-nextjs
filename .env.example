# =============================================================================
#  Carter Cole & Associates — environment variables
# =============================================================================
#  Copy this file to .env.local and fill in every blank value.
#  Every variable here is ALSO required in Vercel:
#    Vercel Dashboard -> your project -> Settings -> Environment Variables
#  Adding them in Vercel does nothing until you REDEPLOY.
#
#  Rules:
#   - Never commit .env.local to git (.gitignore already excludes it).
#   - Never put a secret behind NEXT_PUBLIC_. Anything with that prefix is
#     compiled into the JavaScript every visitor downloads.
#   - No quotes needed unless the value contains spaces.
#   - Do not put comments on the same line as a value.
# =============================================================================


# =============================================================================
#  1. SUPABASE — your database. REQUIRED.
# =============================================================================
#  Where to get these:
#    supabase.com -> your project -> Project Settings -> API
#
#  SUPABASE_URL              = the "Project URL"
#  SUPABASE_SERVICE_ROLE_KEY = the "service_role" secret, NOT the anon key
#
#  The service_role key bypasses Row Level Security and is used only in
#  server-side API routes. Treat it like a password — anyone holding it can
#  read, export or delete your entire mailing list.
#
#  Before this works, run supabase/schema.sql once in the Supabase SQL Editor.
# =============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
#  2. EMAIL SENDING — free Gmail account over nodemailer. REQUIRED.
# =============================================================================
#  SMTP_USER is your full @gmail.com address.
#  SMTP_PASS is a Google APP PASSWORD — 16 characters, NOT your login password.
#
#  How to create the App Password:
#    1. The account must have 2-Step Verification turned ON.
#       myaccount.google.com -> Security -> 2-Step Verification
#    2. Go to myaccount.google.com/apppasswords
#    3. Name it "Carter Cole website" and create it.
#    4. Google shows 16 characters in four groups. Paste them below.
#       Spaces are fine, or remove them — either works.
#
#  If /apppasswords says the option isn't available, 2-Step Verification is
#  off. There is no other way in: Google removed "less secure app access".
#
#  PORTS: 587 = STARTTLS (use this). 465 = SSL, also fine. 25 is blocked by
#  Vercel and most hosts — do not use it.
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=


# =============================================================================
#  2a. THE FROM ADDRESS — the one real limitation of a free Gmail account
# =============================================================================
#  A free @gmail.com account cannot DKIM-sign mail for your own domain. Only
#  paid Google Workspace can do that. This has a practical consequence:
#
#  By default Google REWRITES the From header to the authenticated account.
#  So if SMTP_USER is yourname@gmail.com, that is what recipients see —
#  whatever you put in MAIL_FROM.
#
#  You have two choices.
#
#  ---------------------------------------------------------------------------
#  OPTION 1 — send as the Gmail address (honest, best deliverability)
#  ---------------------------------------------------------------------------
#  Set MAIL_FROM to the same Gmail address, and MAIL_REPLY_TO to the business
#  address so replies still reach the right inbox:
#
#    MAIL_FROM="Lashanda Carter <yourname@gmail.com>"
#    MAIL_REPLY_TO=info@cartercoleandassociates.com
#
#  Less polished, but it authenticates cleanly and lands in inboxes.
#
#  ---------------------------------------------------------------------------
#  OPTION 2 — send as the business address (looks right, riskier)
#  ---------------------------------------------------------------------------
#  In Gmail: Settings -> Accounts and Import -> "Send mail as" -> Add another
#  email address. Enter info@cartercoleandassociates.com, and Google emails a
#  confirmation code to that Bluehost mailbox. Confirm it, then set:
#
#    MAIL_FROM="Carter Cole & Associates <info@cartercoleandassociates.com>"
#
#  Google will then send with that From header. Be aware of the trade-off:
#  the message is DKIM-signed by gmail.com, not by your domain, so DMARC
#  alignment fails. Neither of your domains publishes an enforcing DMARC
#  policy today, so mail will still be delivered — but spam placement is more
#  likely, especially to Outlook. Fix the SPF records in section 2c and it
#  improves considerably.
#
#  Either way, do NOT leave MAIL_FROM as an address you have not verified:
#  Google silently rewrites it and you will not know your branding is gone.
# =============================================================================
MAIL_FROM=
MAIL_REPLY_TO=info@cartercoleandassociates.com


# =============================================================================
#  2b. SENDING LIMITS — how the site protects your Gmail account
# =============================================================================
#  A free @gmail.com account is capped at roughly 500 messages per day.
#  (Paid Google Workspace allows 2,000; trial accounts 500.)
#
#  Exceed the cap and the account CANNOT SEND ANYTHING for 24 hours —
#  including your contact form notifications, and including your personal
#  mail if this is an account you also use yourself.
#
#  To make that impossible, the dispatcher counts what it has actually sent in
#  the rolling last 24 hours and stops short of MAIL_DAILY_LIMIT. Anyone not
#  reached is picked up on the next run. Nothing is ever sent twice, and
#  nobody is skipped.
#
#  MAIL_DAILY_LIMIT — 300 leaves clear headroom under Gmail's ~500 for the
#  contact form and your own email. Raise it to ~1500 if you move to paid
#  Workspace.
#
#  MAIL_THROTTLE_MS — pause between messages so a run doesn't look like a
#  burst. 1200ms is about one per second.
#
#  STRONGLY RECOMMENDED: use a dedicated Gmail account for this, not your
#  personal one. If the site hits the cap, a shared account stops sending your
#  own mail too.
# =============================================================================
MAIL_DAILY_LIMIT=300
MAIL_THROTTLE_MS=1200


# =============================================================================
#  2c. DNS — REQUIRED, or Google's mail goes to spam
# =============================================================================
#  You send from TWO domains, and both are hosted at Bluehost, not Google.
#  Each needs Google added to its SPF before Google may send as it.
#
#  ---------------------------------------------------------------------------
#  URGENT — cartercoleandassociates.com publishes TWO SPF records:
#
#    v=spf1 ip4:173.254.104.88 a mx include:websitewelcome.com ~all
#    v=spf1 include:spf.cloudus.oxcs.net ~all
#
#  A domain is allowed exactly ONE. With two, receivers return permerror and
#  SPF fails outright — mail from this domain is failing authentication right
#  now, no matter which provider sends it. DELETE BOTH and publish this single
#  merged record:
#
#    v=spf1 ip4:173.254.104.88 a mx include:websitewelcome.com include:spf.cloudus.oxcs.net include:_spf.google.com ~all
#
#  ---------------------------------------------------------------------------
#  smarttaxiq.com currently reads:
#
#    v=spf1 +a +mx +ip4:50.6.2.58 include:bluehost.com ~all
#
#  One record, which is correct, but it does not authorise Google. Change to:
#
#    v=spf1 +a +mx +ip4:50.6.2.58 include:bluehost.com include:_spf.google.com ~all
#
#  ---------------------------------------------------------------------------
#  DKIM: neither domain is verified with Google (no google._domainkey record,
#  no site verification). DKIM signing requires PAID Google Workspace with the
#  domain added to it — Admin console -> Apps -> Google Workspace -> Gmail ->
#  Authenticate email. A free @gmail.com account cannot sign mail for your
#  domain, so sending as @cartercoleandassociates.com or @smarttaxiq.com from
#  free Gmail will land in spam no matter what else you configure.
#
#  DMARC: smarttaxiq.com is at v=DMARC1;p=none (monitoring only). Leave it
#  there until SPF and DKIM both pass, then tighten to p=quarantine.
#
#  Check your work at mxtoolbox.com/spf.aspx after any change. DNS edits take
#  up to a few hours to propagate.
# =============================================================================

# =============================================================================
#  3. SITE URL — REQUIRED. Builds download and unsubscribe links.
# =============================================================================
#  No trailing slash.
#  Locally:      http://localhost:3000
#  In Vercel:    https://cartercoleandassociates.com
#
#  Get this wrong in production and every unsubscribe link in every email
#  you send points at the wrong domain.
# =============================================================================
SITE_URL=https://cartercoleandassociates.com


# =============================================================================
#  4. CRON SECRET — REQUIRED. Protects the email dispatcher.
# =============================================================================
#  Any long random string. Generate one with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#  Vercel automatically sends this as an Authorization: Bearer header when it
#  runs the schedule in vercel.json. Without it, /api/cron/dispatch returns
#  401 and not a single sequence email is ever sent.
# =============================================================================
CRON_SECRET=


# =============================================================================
#  5. ADMIN DASHBOARD PASSWORD — REQUIRED to open /admin/subscribers.
# =============================================================================
#  One password guards the subscriber list and the contact inbox. Make it
#  long. If it is unset, the dashboard locks itself and shows a notice.
# =============================================================================
ADMIN_PASSWORD=


# =============================================================================
#  6. STRIPE — for selling the $17 workbook. OPTIONAL until you sell.
# =============================================================================
#  There are two ways to take payment. Pick one.
#
#  ---------------------------------------------------------------------------
#  OPTION A — Payment Link (no code, works today)
#  ---------------------------------------------------------------------------
#  Stripe Dashboard -> Payment Links -> Create link -> copy the URL.
#  Paste it into STRIPE_PAYMENT_LINK_WORKBOOK below and set the same value as
#  CHECKOUT_URL in src/app/workbook/page.tsx. Every buy button goes live at
#  once. Stripe hosts the page, handles tax and receipts. Nothing else needed.
#
#  ---------------------------------------------------------------------------
#  OPTION B — Stripe Checkout API (needs the keys below)
#  ---------------------------------------------------------------------------
#  More work, but you can attach the buyer to their subscriber record, deliver
#  the PDF automatically, and track who bought what.
#
#  Where to get each value:
#
#  STRIPE_SECRET_KEY
#    Stripe Dashboard -> Developers -> API keys -> "Secret key".
#    Starts sk_test_ in test mode, sk_live_ in live mode.
#    SERVER ONLY. Never expose this. It can issue refunds and read payouts.
#
#  NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#    Same page -> "Publishable key". Starts pk_test_ / pk_live_.
#    This one is SAFE in the browser — that is what NEXT_PUBLIC_ means, and
#    it is the ONLY Stripe value that may carry that prefix.
#
#  STRIPE_PRICE_ID_WORKBOOK
#    Stripe Dashboard -> Product catalogue -> your workbook product -> the
#    price -> copy its ID. Starts price_. NOT the product ID (prod_).
#
#  STRIPE_WEBHOOK_SECRET
#    Stripe Dashboard -> Developers -> Webhooks -> Add endpoint.
#    Endpoint URL: https://cartercoleandassociates.com/api/stripe/webhook
#    Event to listen for: checkout.session.completed
#    Then copy the "Signing secret". Starts whsec_.
#    Locally, get a temporary one by running:  stripe listen --forward-to
#    localhost:3000/api/stripe/webhook
#
#    This secret is what proves an incoming webhook really came from Stripe.
#    Without verifying it, anyone could POST a fake "payment succeeded" to
#    your site and be given the workbook for free.
#
#  Test mode and live mode have completely separate keys, price IDs and
#  webhook secrets. Use test keys locally, live keys in Vercel.
# =============================================================================
STRIPE_PAYMENT_LINK_WORKBOOK=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_WORKBOOK=
STRIPE_WEBHOOK_SECRET=

#  Where Stripe returns the buyer after payment. Paths on your own site.
STRIPE_SUCCESS_URL=/workbook/thank-you
STRIPE_CANCEL_URL=/workbook
