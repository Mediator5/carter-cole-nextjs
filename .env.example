# ---- Mail sending (required for the sequence to actually send) ----
# Works with Amazon SES, Postmark, Mailgun, Resend SMTP, or your own domain mail.
# Do NOT use a personal Gmail account for list sending.
SMTP_HOST=email-smtp.us-east-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lashanda Carter <lashanda@smarttaxiq.com>"
MAIL_REPLY_TO=lashanda@smarttaxiq.com

# ---- Site ----
SITE_URL=https://cartercoleassociates.com

# ---- Cron protection (any long random string) ----
CRON_SECRET=change-me-to-a-long-random-string

# ---- Admin dashboard password ----
ADMIN_PASSWORD=change-me

# ---- Optional: where the SQLite file lives ----
# DATABASE_PATH=/var/data/subscribers.db
