# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# SQLite database — replaced by Supabase, kept ignored for old checkouts.
data/

# NOTE: private-assets/*.pdf used to be ignored here. It must NOT be, because
# Vercel deploys from git: an untracked PDF simply does not exist in
# production and every gated download 404s. The PDFs are still protected —
# they live outside /public and can only be reached with a subscriber token.

.env.local
